{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/format-after-edit.mjs",
        "timeout": 30,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/typecheck-after-stop.mjs",
        "timeout": 130,
        "failClosed": false,
        "loop_limit": 1
      }
    ]
  }
}
